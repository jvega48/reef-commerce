generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users, auth, and staff roles
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  INVENTORY_MANAGER
  SHIPPING_MANAGER
  SUPPORT
  MARKETING
  VIEWER
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?
  image         String?
  phone         String?
  marketingOptIn Boolean  @default(false)
  vipTier       VipTier   @default(NONE)
  reefPoints    Int       @default(0)
  storeCredit   Decimal   @default(0) @db.Decimal(10, 2)
  notes         String? // internal CRM notes
  tags          String[] // CRM tags, e.g. "VIP", "wholesale"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Notification preferences (marketingOptIn above covers promotions)
  notifyOrderUpdates Boolean @default(true)
  notifyRestock      Boolean @default(true)

  // Referral program: each user gets a shareable code; referredById records
  // who sent them so both sides can be rewarded on first purchase.
  referralCode String? @unique
  referredById String?

  accounts          Account[]
  sessions          Session[]
  addresses         Address[]
  orders            Order[]
  cart              Cart?
  wishlistItems     WishlistItem[]
  reviews           Review[]
  pointsTransactions PointsTransaction[]
  stockAlerts       StockAlert[]
  auditLogs         AuditLog[]
  supportTickets    SupportTicket[]
  ticketMessages    TicketMessage[]
  giftCardsBought   GiftCard[]
}

enum VipTier {
  NONE
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

// Auth.js standard models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  SOLD
}

enum InventoryMode {
  STANDARD // quantity-tracked, customer gets a representative specimen
  WYSIWYG  // this listing IS the exact specimen photographed; qty is 1 and it
           // is auto-marked SOLD when purchased
}

enum LivestockType {
  CORAL
  FISH
  INVERTEBRATE
  DRY_GOOD
  MERCH
}

enum CareLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum Intensity {
  LOW
  MEDIUM
  HIGH
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    ProductCategory[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id             String        @id @default(cuid())
  sku            String        @unique
  name           String
  slug           String        @unique
  scientificName String?
  description    String? // rich text / HTML
  status         ProductStatus @default(DRAFT)
  inventoryMode  InventoryMode @default(STANDARD)
  livestockType  LivestockType @default(CORAL)

  // Husbandry / care profile
  careLevel   CareLevel?
  lighting    Intensity?
  flow        Intensity?
  placement   String? // e.g. "High", "Bottom", "Rockwork"
  temperament String? // e.g. "Peaceful", "Semi-aggressive"
  minTankSizeGallons Int?
  growthRate  String?
  colors      String[]

  // WYSIWYG specimen details (when inventoryMode = WYSIWYG)
  specimenSize String? // e.g. "1.5 inch frag, 6 heads"
  growthForm   String?

  // Commerce
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2) // "was" price for sales
  cost           Decimal? @db.Decimal(10, 2) // for profit reporting
  quantity       Int      @default(0)
  lowStockThreshold Int   @default(2)
  weightGrams    Int      @default(0)
  taxable        Boolean  @default(true)
  vendor         String?
  collectionDate DateTime?
  arrivalDate    DateTime?
  shippingRestrictions String? // e.g. "No shipping to HI"

  // Merchandising & SEO
  tags            String[]
  featured        Boolean @default(false)
  metaTitle       String?
  metaDescription String?

  // Denormalized review + sales stats (updated on review approval / order
  // finalize) so listing pages never need aggregate queries.
  ratingAvg   Decimal @default(0) @db.Decimal(3, 2)
  ratingCount Int     @default(0)
  soldCount   Int     @default(0)

  // Full-text search: generated tsvector column + GIN index, created in the
  // migration SQL (Prisma can't express generated columns natively).
  search Unsupported("tsvector")?

  // Provenance (Shopify migration)
  shopifyId     BigInt? @unique
  shopifyHandle String?

  images        ProductImage[]
  categories    ProductCategory[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  stockAlerts   StockAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, livestockType])
  @@index([status, createdAt])
  @@index([slug])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  // Optimized 400px square generated at upload time. Null for the migrated
  // Shopify catalog, which is served straight from their CDN.
  thumbUrl  String?
  alt       String?
  position  Int     @default(0)
  width     Int?
  height    Int?
  bytes     Int?
  isVideo   Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

// ---------------------------------------------------------------------------
// Cart & checkout
// ---------------------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique // anonymous carts
  items     CartItem[]
  // Abandoned-cart recovery: email captured at checkout start; a tokenized
  // "resume your cart" link is emailed after the cart goes stale.
  email               String?
  recoveryToken       String?   @unique
  recoveryEmailSentAt DateTime?
  recoveredAt         DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([updatedAt])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([cartId, productId])
}

// ---------------------------------------------------------------------------
// Orders & fulfillment
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  PACKING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber Int         @unique @default(autoincrement())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  email       String
  status      OrderStatus @default(PENDING)

  subtotal     Decimal @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  shippingCost Decimal @default(0) @db.Decimal(10, 2)
  tax          Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])
  pointsRedeemed Int @default(0)

  giftCardId     String?
  giftCard       GiftCard? @relation(fields: [giftCardId], references: [id])
  giftCardAmount Decimal   @default(0) @db.Decimal(10, 2)

  // Gift orders get a gift receipt (no prices) instead of an invoice.
  isGift      Boolean @default(false)
  giftMessage String?

  refundAmount Decimal @default(0) @db.Decimal(10, 2)
  refundReason String?

  stripePaymentIntentId String? @unique
  stripeCheckoutSessionId String? @unique

  shippingAddressId String?
  shippingAddress   Address? @relation(fields: [shippingAddressId], references: [id])

  internalNotes String?
  items         OrderItem[]
  shipments     Shipment[]
  events        OrderEvent[]
  tickets       SupportTicket[]
  giftCardsIssued GiftCard[] @relation("GiftCardPurchaseOrder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  // Snapshot at purchase time so history survives product edits/deletes
  name      String
  sku       String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int
  imageUrl  String?

  @@index([orderId])
  @@index([productId])
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  EXCEPTION
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier        String         @default("UPS")
  service        String? // e.g. "UPS Next Day Air"
  trackingNumber String?
  labelUrl       String?
  cost           Decimal?       @db.Decimal(10, 2)
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("US")
  phone      String?
  isDefault  Boolean @default(false)
  residential Boolean @default(true)
  orders     Order[]
}

// ---------------------------------------------------------------------------
// Promotions, loyalty, engagement
// ---------------------------------------------------------------------------

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  type          DiscountType
  value         Decimal      @db.Decimal(10, 2)
  minSubtotal   Decimal?     @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int          @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  active        Boolean      @default(true)
  orders        Order[]
  createdAt     DateTime     @default(now())
}

enum PointsReason {
  PURCHASE
  REVIEW
  REFERRAL
  BIRTHDAY
  SIGNUP
  SOCIAL_SHARE
  REDEEMED
  ADJUSTMENT
}

model PointsTransaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int // positive = earned, negative = redeemed
  reason    PointsReason
  orderId   String?
  note      String?
  createdAt DateTime     @default(now())

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating     Int // 1-5
  title      String?
  body       String?
  approved   Boolean  @default(false)
  verified   Boolean  @default(false) // reviewer actually bought this product
  adminReply String?
  createdAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId, approved])
}

model StockAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// Order timeline — one row per lifecycle event, rendered on both the admin
// order page and the customer's order-tracking page.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // e.g. "status", "payment", "shipment", "note", "refund"
  message   String
  visibleToCustomer Boolean @default(true)
  createdById String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model GiftCard {
  id             String   @id @default(cuid())
  code           String   @unique // AV365-XXXX-XXXX-XXXX
  initialBalance Decimal  @db.Decimal(10, 2)
  balance        Decimal  @db.Decimal(10, 2)
  active         Boolean  @default(true)
  purchasedById  String?
  purchasedBy    User?    @relation(fields: [purchasedById], references: [id])
  purchaseOrderId String?
  purchaseOrder  Order?   @relation("GiftCardPurchaseOrder", fields: [purchaseOrderId], references: [id])
  recipientEmail String?
  recipientName  String?
  message        String?
  deliveredAt    DateTime? // when the code was emailed to the recipient
  expiresAt      DateTime?
  ordersRedeemed Order[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  AWAITING_CUSTOMER
  AWAITING_SUPPORT
  RESOLVED
  CLOSED
}

enum TicketTopic {
  ORDER_ISSUE
  DOA_CLAIM
  SHIPPING
  PRODUCT_QUESTION
  WHOLESALE
  DISTRIBUTOR
  ACCOUNT
  OTHER
}

model SupportTicket {
  id        String       @id @default(cuid())
  number    Int          @unique @default(autoincrement())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  email     String
  name      String?
  subject   String
  topic     TicketTopic  @default(OTHER)
  status    TicketStatus @default(OPEN)
  orderId   String?
  order     Order?       @relation(fields: [orderId], references: [id])
  messages  TicketMessage[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, updatedAt])
  @@index([userId])
  @@index([email])
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?         @relation(fields: [authorId], references: [id])
  fromStaff Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ---------------------------------------------------------------------------
// Content & email
// ---------------------------------------------------------------------------

enum ArticleCategory {
  LEARNING        // Learning Center guides
  WATER_EDUCATION // water chemistry / parameters series
  KNOWLEDGE_BASE  // support how-tos
}

model Article {
  id           String          @id @default(cuid())
  slug         String          @unique
  title        String
  excerpt      String
  body         String // sanitized HTML
  category     ArticleCategory @default(LEARNING)
  heroImageUrl String?
  tags         String[]
  readMinutes  Int             @default(4)
  published    Boolean         @default(true)
  publishedAt  DateTime        @default(now())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([category, published, publishedAt])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String    @default("footer") // footer, checkout, popup
  unsubscribeToken String  @unique @default(cuid())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256 of the emailed token
  email     String
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}

// Outbound email log — every send (real via Resend, or console fallback in
// dev) is recorded here for observability and abandoned-cart dedupe.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String
  status    String // SENT, FAILED, CONSOLE
  error     String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([template, to])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Ops
// ---------------------------------------------------------------------------

// One row per settings group (e.g. "shipping", "storeInfo", "guarantee").
// Values are merged over code defaults so a missing row/field falls back to
// the published policy defaults in src/lib/settings.ts.
model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // e.g. "product.update", "order.refund"
  entity    String? // e.g. "Product:abc123"
  detail    Json?
  createdAt DateTime @default(now())

  @@index([entity])
}
